{
  "name": "mimir-nl",
  "version": "0.3.0",
  "type": "module",
  "description": "Local-first project memory engine",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "mimir": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs/architecture.md",
    "docs/backup-restore.md",
    "docs/dependencies.md",
    "docs/mcp.md",
    "docs/mcp-schemas.json",
    "docs/security.md",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/release-0.3.0.md",
    "docs/core-retrieval-0.3.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "npm run build && node test/benchmark.mjs",
    "format": "prettier --write src test scripts docs *.md *.json *.mjs .github/workflows/*.yml",
    "format:check": "prettier --check src test scripts docs *.md *.json *.mjs .github/workflows/*.yml",
    "docs:schemas": "npm run build && node scripts/generate-contract.mjs",
    "lint": "eslint src",
    "schemas:check": "npm run build && node scripts/generate-contract.mjs --check",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.10.0",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
