      },
      "mode": {
        "type": "string",
        "enum": ["real_use", "controlled_experiment", "synthetic"]
      },
      "identity": {
        "default": {
          "commit": null,
          "dirtyHash": null,
          "requestedModel": null,
          "observedModel": null,
          "observedModelReason": "not_collected",
          "configHash": null,
          "promptHash": null,
          "configOrigin": "unknown"
        },
        "type": "object",
        "properties": {
          "commit": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dirtyHash": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "requestedModel": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedModel": {
            "default": null,
            "type": "null"
          },
          "observedModelReason": {
            "default": "not_collected",
            "type": "string",
            "enum": [
              "not_available",
              "not_collected",
              "not_applicable",
              "semantics_unconfirmed",
              "no_paired_control",
              "source_not_verified"
            ]
          },
          "configHash": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "promptHash": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "configOrigin": {
            "default": "unknown",
            "type": "string",
            "enum": ["provided", "unknown"]
          }
        },
        "required": [
          "commit",
          "dirtyHash",
          "requestedModel",
          "observedModel",
          "observedModelReason",
          "configHash",
          "promptHash",
          "configOrigin"
        ],
        "additionalProperties": false
      },
      "retryOf": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      },
      "retryReason": {
