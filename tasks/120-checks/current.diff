@@ -0,0 +1,20 @@
+import { mkdirSync, mkdtempSync, realpathSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
+import { localPath, safePath } from "./offline-files.mjs";
+
+// Resolve the configured system temp root and require an existing, non-symlink
+// parent beneath it. relative() checks a component boundary, including drives.
+export function temporaryOutput(path, prefix) {
+  const temporary = realpathSync(tmpdir());
+  if (!path) return mkdtempSync(join(temporary, prefix));
+  const full = resolve(path);
+  localPath(full);
+  safePath(dirname(full));
+  const parent = realpathSync(dirname(full));
+  const delta = relative(temporary, parent);
+  if (isAbsolute(delta) || delta === ".." || delta.startsWith(".." + sep))
+    throw Error("Output must be under the system temporary directory");
+  mkdirSync(full, { mode: 0o700 });
+  return full;
+}
--- historical/test/platform-fixture.mjs
+++ current/test/platform-fixture.mjs
@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import { symlinkSync, statSync } from "node:fs";
+import { test } from "node:test";
+
+// Only the setup requiring a Windows privilege may be skipped. Callers keep
+// running collision, malformed-input, cleanup and canary assertions afterward.
+export function withSymlink(target, path, check) {
+  try {
+    symlinkSync(target, path);
+  } catch (error) {
+    if (process.platform !== "win32" || error.code !== "EPERM") throw error;
+    test(
+      "symlink rejection: setup requires Windows symlink privilege",
+      {
+        skip: "Windows returned EPERM while creating the test symlink",
+      },
+      () => {},
+    );
+    return;
+  }
+  check();
+}
+
+// Windows chmod exposes read/write flags, not POSIX ownership or ACL privacy.
+// Keep exact private-mode assertions on POSIX; never claim ACL isolation here.
+export function assertPrivateMode(path, expected) {
+  const mode = statSync(path).mode & 0o777;
+  if (process.platform === "win32") assert.equal(mode & 0o600, 0o600);
+  else assert.equal(mode, expected);
+}
